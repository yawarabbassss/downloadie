# ========================================================
# Downloadie - Environment Configuration Example
# ========================================================

# --- Backend Application Settings ---
APP_NAME="Downloadie API"
APP_ENV=development
DEBUG=false
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Cryptographic Secret Key for HMAC Ephemeral Tokens
# (Generate a strong random 32+ character string in production)
SECRET_KEY=downloadie-dev-secret-key-change-in-production-12345678

# --- Security & Resource Limits ---
# Maximum media download size limit in bytes (Default: 150 MB)
MAX_DOWNLOAD_SIZE_BYTES=157286400
REQUEST_TIMEOUT_SECONDS=20.0
RATE_LIMIT_PER_MINUTE=45
RATE_LIMIT_BURST=10
ALLOW_PRIVATE_NETWORKS_FOR_TESTS=false

# --- Ephemeral Storage & Retention ---
STORAGE_DIR=./data/downloads
JOB_EXPIRATION_MINUTES=60
MAX_STORAGE_QUOTA_MB=2048

# --- Database ---
# SQLite default for local zero-config, or PostgreSQL / Supabase
DATABASE_URL=sqlite+aiosqlite:///./data/downloadie.db
# Example PostgreSQL / Supabase URL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres

# --- Optional Official Platform API Credentials ---
# Note: Downloadie works out-of-the-box for direct media links without any keys.
# Configure these official credentials if you have approved developer access.

# Meta Graph API (Instagram Basic Display / Graph API):
# https://developers.facebook.com/apps/
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 (Google Cloud Console):
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# TikTok for Developers (Display API):
# https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta Graph API (Facebook Page Public Content Access):
FACEBOOK_ACCESS_TOKEN=

# --- Frontend Settings ---
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
